# Copy to .env.local and fill in. Both .env and .env.local are gitignored.
#
# These are for the OFFLINE labeling pipeline in /model only. Nothing here is
# read by the browser build, and nothing here ships.
#
# NEVER prefix a secret with VITE_. Vite inlines VITE_* variables into the
# client bundle at build time, which would publish the value to every visitor.

# Exact model id from your provider. Find yours with:
#   python3 model/generate_dataset.py --list-models
DRIFT_LABEL_MODEL=

# Whichever provider you are labeling with. You only need one.
GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
