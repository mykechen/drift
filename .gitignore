# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
.vite/
*.tsbuildinfo

# Environment
.env
.env.*
!.env.example

# Browser automation scratch output
.playwright-mcp/

# Editor / OS
.DS_Store
.idea/
*.swp

# Model training artifacts. Shipping ONNX files live in src/ml/models/ and ARE checked in.
model/data/*
# Pilot runs are small and are the evidence behind axes.md — keep them.
!model/data/pilot-*.json
# Hand-authored inputs. curated.txt cannot be regenerated and also becomes the
# source for behaviors.ts in Phase 6. wordlist.csv is deliberately NOT kept —
# it rebuilds from these two plus the pinned wordfreq version.
!model/data/curated.txt
!model/data/blocklist.txt
# The labeled dataset and its raw per-pass provenance. LLM output is not
# deterministic, so this cannot be rebuilt identically — it is the frozen
# artifact Phase 1b trains on, not a regenerable cache. wordlist.csv stays
# ignored (it rebuilds from curated.txt + wordfreq).
!model/data/dataset.csv
!model/data/labels-pass1.jsonl
!model/data/labels-pass2.jsonl
!model/data/calib-gemini.jsonl
!model/data/calibration-words.txt
model/checkpoints/
model/.venv/
__pycache__/
*.pyc

# Licensed fonts. If the display family ships under a commercial license, its
# binaries must not be published. Uncomment before making this repo public and
# deliver the font files out-of-band.
# public/fonts/
